{
  "name": "starter-prismakit-nestjs",
  "version": "0.0.1",
  "description": "NestJS e-commerce starter showcasing PrismaKit (cache, compose, locks, execTx, MinIO presign)",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node build/compile/src/main",
    "seed": "npx ts-node -r tsconfig-paths/register prisma/seed.ts",
    "lint": "eslint \"{src,prisma}/**/*.ts\" prisma.config.ts jest.config.ts --fix",
    "lint:check": "eslint \"{src,prisma}/**/*.ts\" prisma.config.ts jest.config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "gen:module": "prismakit generate",
    "validate:compose": "prismakit validate --schema prisma/schema.prisma --auto-register"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prismakit/core": "3.0.2",
    "@prismakit/nestjs": "3.0.2",
    "@prismakit/redis": "3.0.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express-basic-auth": "^1.2.1",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@prismakit/cli": "3.0.2",
    "@prismakit/eslint-plugin": "3.0.0",
    "@prismakit/memory": "3.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  }
}
