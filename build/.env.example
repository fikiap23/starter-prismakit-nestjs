# =========================
# Backend
# =========================
PORT_BE=3000
PORT=3000

# =========================
# PostgreSQL
# =========================
DB_HOST=starter-prismakit-database-postgres-dev
DB_PORT=5432
DB_NAME=starter
DB_USER=app
DB_PASSWORD=apppassword
POSTGRES_USER=app
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=starter

# =========================
# Prisma
# =========================
DATABASE_URL_DEV=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}

# =========================
# Redis
# =========================
REDIS_HOST=starter-prismakit-redis-dev
REDIS_PORT=6379
REDIS_PREFIX=starter
REDIS_DEFAULT_TTL=300
CACHE_DEBUG=false
PORT_REDIS_COMMANDER=8081
REDIS_COMMANDER_HTTP_USER=admin
REDIS_COMMANDER_HTTP_PASSWORD=admin

# =========================
# Auth
# =========================
JWT_SECRET=your-super-secret-jwt-key
ADMIN_EMAIL_SEED=admin@gmail.com
ADMIN_PASSWORD_SEED=admin123!

# =========================
# Swagger
# =========================
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =========================
# MinIO
# =========================
MINIO_ROOT_USER=app
MINIO_ROOT_PASSWORD=apppassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=starter-prismakit-minio-dev
MINIO_ENDPOINT_PORT=9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PRESIGN_ENDPOINT=
MINIO_BUCKET_NAME=starter
MINIO_ACCESS_KEY=app
MINIO_SECRET_KEY=apppassword
