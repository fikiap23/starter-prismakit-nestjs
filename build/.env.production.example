PORT=3000
NODE_ENV=production

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=starter
DATABASE_URL=postgresql://app:change-me@starter-prismakit-database-postgres-production:5432/starter

JWT_SECRET=change-me
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=change-me
CORS_ORIGINS=https://example.com
RUN_SEED=0
ADMIN_EMAIL_SEED=admin@example.com
ADMIN_PASSWORD_SEED=change-me

REDIS_HOST=starter-prismakit-redis-production
REDIS_PORT=6379
REDIS_PREFIX=starter
REDIS_DEFAULT_TTL=300

MINIO_ENDPOINT=starter-prismakit-minio-production
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=app
MINIO_SECRET_KEY=change-me
MINIO_PUBLIC_URL=https://minio.example.com
MINIO_PRESIGN_ENDPOINT=
MINIO_BUCKET_NAME=starter
