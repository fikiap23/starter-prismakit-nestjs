FROM node:22-alpine AS base

RUN apk add --no-cache openssl

FROM base AS deps

WORKDIR /usr/src/app

COPY package.json package-lock.json* ./
COPY .npmrc ./
COPY prisma.config.ts ./
COPY prisma ./prisma/
RUN npm ci

FROM base AS production-deps

WORKDIR /usr/src/app

COPY package.json package-lock.json* ./
COPY .npmrc ./
COPY prisma.config.ts ./
COPY prisma ./prisma/
RUN npm ci --omit=dev --ignore-scripts \
  && npm install prisma@7.8.0 ts-node tsconfig-paths typescript --no-save --ignore-scripts

FROM base AS build

WORKDIR /usr/src/app

COPY --from=deps /usr/src/app/node_modules /usr/src/app/node_modules

COPY prisma ./prisma/

COPY . .
RUN npx prisma generate
RUN npm run build

FROM base

ENV PORT=3000
ENV NODE_ENV=production

WORKDIR /usr/src/app

COPY --from=production-deps /usr/src/app/node_modules /usr/src/app/node_modules
COPY --from=build /usr/src/app/src/generated /usr/src/app/src/generated
COPY --from=build /usr/src/app/build/compile /usr/src/app/build/compile
COPY --from=build /usr/src/app/package.json /usr/src/app/package.json
COPY --from=build /usr/src/app/prisma /usr/src/app/prisma
COPY --from=build /usr/src/app/prisma.config.ts /usr/src/app/prisma.config.ts
COPY --from=build /usr/src/app/tsconfig.json /usr/src/app/tsconfig.json
COPY --from=build /usr/src/app/build/entrypoint.production.sh /usr/src/app/build/entrypoint.production.sh
COPY --from=build /usr/src/app/build/fix-generated-ownership.sh /usr/src/app/build/fix-generated-ownership.sh

RUN sed -i 's/\r//' /usr/src/app/build/entrypoint.production.sh \
  && sed -i 's/\r//' /usr/src/app/build/fix-generated-ownership.sh \
  && chmod +x /usr/src/app/build/entrypoint.production.sh

ENTRYPOINT [ "./build/entrypoint.production.sh" ]
