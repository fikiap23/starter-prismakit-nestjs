# Local (non-Docker) — Docker uses build/.env instead.
PORT=3000
DATABASE_URL=postgresql://app:apppassword@localhost:5432/starter
JWT_SECRET=your-super-secret-jwt-key
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin
CORS_ORIGINS=http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PREFIX=starter
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=app
MINIO_SECRET_KEY=apppassword
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PRESIGN_ENDPOINT=
MINIO_BUCKET_NAME=starter
ADMIN_EMAIL_SEED=admin@example.com
ADMIN_PASSWORD_SEED=admin123!
